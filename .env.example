# Supabase Credentials for AegisOps Emergency Response
# Replace with your project URL and anon public key from Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Gemini API Key for AEGIS-MEDIC AI Triage Assistant
# (Optional: If absent or offline, automatically fails over to pre-loaded local first-aid guides)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

